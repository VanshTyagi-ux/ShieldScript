# Copy to .env and adjust. Variable names are case-insensitive.

PROJECT_NAME="XSS Detector API"
VERSION="0.1.0"
DEBUG=false

# Database. SQLite (a file in backend/) is the default and needs nothing installed.
DATABASE_URL=sqlite:///./app.db
# PostgreSQL instead - uncomment and fill in (postgres:// and postgresql:// URLs are accepted too):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/xss_detector
# (Under Docker Compose the database and this URL are set up for you; see the repository's docker-compose.yml.)

# Largest request body accepted, in bytes (413 above this).
MAX_BODY=262144

# Longest HTML (in characters) POST /api/v1/sanitize accepts; longer input gets a 413.
MAX_HTML_LENGTH=64000

# Origins allowed by CORS, as a JSON array (React dev servers: CRA/Next 3000, Vite 5173).
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Per-client rate limiting on API_V1_PREFIX (429 + Retry-After above the limit); same defaults and semantics
# as the stdlib server (see the repository README). GET /rules, /benchmark and /payloads* cost a quarter of
# a POST /scan, /submit or /sanitize; /health is never limited.
RATE_LIMIT=60
RATE_BURST=20
# Proxies in front of this API whose X-Forwarded-For entry to trust (0 = ignore the header; the client is
# always the TCP peer). Only raise this if every request genuinely passes through that many trusted hops -
# e.g. leave at 0 if, as in this repository's docker-compose.yml, the backend port is also reachable
# directly and not solely behind a proxy.
TRUSTED_PROXY_HOPS=0
