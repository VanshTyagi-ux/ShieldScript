# Copy to .env.local (git-ignored) to override. Only variables starting with VITE_ reach the browser bundle.
# Files are read in this order, later ones winning: .env, .env.local, .env.<mode>, .env.<mode>.local,
# then real environment variables. <mode> is "development" for `npm run dev` and "production" for `npm run build`.

# Base URL of the API. Every request is this plus a path such as /scan or /payloads.
#
#   http://localhost:8000/api/v1   the FastAPI backend (the default; what `npm run dev` uses)
#   /api                           same origin, the built-in Python server (set by .env.production)
#
# A different port or host works the same way, e.g. VITE_API_URL=https://api.example.com/api/v1
# (the backend must list this site's origin in its CORS_ORIGINS).
VITE_API_URL=http://localhost:8000/api/v1

# Whether to include the pages that need the FastAPI backend: Payloads and Sanitizer (and their API docs).
# On by default; .env.production turns it off because the built-in server does not have those endpoints.
VITE_BACKEND_PAGES=true
