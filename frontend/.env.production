# Used by `npm run build`, which writes ../xss_detector/static/app.js, the bundle the built-in Python server
# ships. Keep both lines, or the committed bundle will not match the server it is served by.

# That server sends `Content-Security-Policy: default-src 'self'`, so the page can only call its own origin,
# where its API lives under /api.
VITE_API_URL=/api

# Its API has no /payloads or /sanitize, so leave the two pages that need the FastAPI backend (and their docs) out.
VITE_BACKEND_PAGES=false
