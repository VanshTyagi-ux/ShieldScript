# Settings for docker-compose.yml. Copy this file to .env (git-ignored) to change any of them; with no .env,
# every value below is the default. The frontend and backend have their own settings (frontend/.env.example,
# backend/.env.example) for running them outside Docker.

# --- PostgreSQL (the db service) -----------------------------------------------------------------------------
POSTGRES_USER=xss
# CHANGE THIS for anything but a throwaway local stack. Keep it URL-safe (letters, digits, - . _ ~): it is placed
# inside the connection URL below. For a password with other characters, set DATABASE_URL yourself.
POSTGRES_PASSWORD=xss
POSTGRES_DB=xss_detector

# --- backend --------------------------------------------------------------------------------------------------
# Built from the three POSTGRES_* values above when not set. Set it to use another database, e.g. the SQLite file
# on the backend's volume:   DATABASE_URL=sqlite:////data/app.db
# DATABASE_URL=

# Create the tables and load data/payloads/*.txt every time the backend starts (skips what is already stored).
SEED_ON_START=true

# --- published ports --------------------------------------------------------------------------------------------
# 127.0.0.1 keeps both services reachable from this machine only. The API has no authentication or rate limiting,
# so use 0.0.0.0 only behind something that provides them.
BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
